-- Render a few rows per scheduler slice so Roblox stays responsive.
task.spawn(function()
    local made = 0

    for y,row in ipairs(ART) do
        local n = #row
        local i = 1

        while i <= n do
            local x1 = row[i]
            local x2 = row[i+1]
            local ci = row[i+2]
            i += 3

            local line = Instance.new("Frame")
            line.Name = "P"
            line.BorderSizePixel = 0
            line.BackgroundColor3 = Colors[ci+1] or Color3.new(1,1,1)
            line.Size = UDim2.new(
                (x2-x1+1)/ART_W, 0,
                1/ART_H, 0
            )
            line.Position = UDim2.new(
                x1/ART_W, 0,
                (y-1)/ART_H, 0
            )
            line.ZIndex = 1
            line.Parent = Canvas

            made += 1

            if made % 250 == 0 then
                task.wait()
            end
        end

        if y % 4 == 0 then
            task.wait()
        end
    end

    print("S348 artwork loaded: " .. tostring(made) .. " line segments")
end)

