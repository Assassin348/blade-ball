--==================================================
-- TARGET SELECT
--==================================================

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then
        return
    end

    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        local mouse = LocalPlayer:GetMouse()
        local target = mouse.Target

        if target then
            local character = target:FindFirstAncestorOfClass("Model")

            if character
                and character:FindFirstChild("Humanoid")
                and character ~= LocalPlayer.Character then

                local player = Players:GetPlayerFromCharacter(character)

                if player then
                    Target = player
                    TargetLabel.Text = "Target: " .. player.Name
                end
            end
        end
    end
end)

--==================================================
-- MAIN MOVEMENT LOOP
--==================================================

RunService.Heartbeat:Connect(function()
    if not Enabled or not Target then
        return
    end

    local targetChar = Target.Character
    local localChar = LocalPlayer.Character

    if not targetChar or not localChar then
        return
    end

    local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
    local localRoot = localChar:FindFirstChild("HumanoidRootPart")

    if not targetRoot or not localRoot then
        return
    end

    local elapsed = tick() - StartTime
    local progress = math.clamp(elapsed / TimeToMax, 0, 1)

    local CurrentSpeed =
        MinSpeed + (MaxSpeed - MinSpeed) * progress

    SpeedLabel.Text = "Speed: " .. math.floor(progress * 100) .. "%"

    Angle += CurrentSpeed

    local offsetX = math.cos(Angle) * Radius
    local offsetZ = math.sin(Angle) * Radius

    local newPos =
        targetRoot.Position +
        Vector3.new(offsetX,0,offsetZ)

    localRoot.CFrame =
        CFrame.new(newPos,targetRoot.Position)
end)

