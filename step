local K = 'eYPluX9NownOtmrpJWmz6h1Ddloi0aoK'
local B = ''
local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local map = {}
for i = 1, #alphabet do map[string.sub(alphabet, i, i)] = i - 1 end
local raw = {}
local out = {}
local oi = 0
local ri = 0
for i = 1, #B, 4 do
    local c1 = map[string.sub(B,i,i)] or 0
    local c2 = map[string.sub(B,i+1,i+1)] or 0
    local c3s = string.sub(B,i+2,i+2)
    local c4s = string.sub(B,i+3,i+3)
    local c3 = map[c3s] or 0
    local c4 = map[c4s] or 0
    local n = c1*262144 + c2*4096 + c3*64 + c4
    local b1 = math.floor(n/65536) % 256
    local b2 = math.floor(n/256) % 256
    local b3 = n % 256
    ri = ri + 1; raw[ri] = b1
    if c3s ~= "=" then ri = ri + 1; raw[ri] = b2 end
    if c4s ~= "=" then ri = ri + 1; raw[ri] = b3 end
end
for i = 1, #raw do
    local kb = string.byte(K, ((i-1) % #K) + 1)
    oi = oi + 1
    out[oi] = string.char((raw[i] + kb) % 256)
end
local source = table.concat(out)
local fn = loadstring(source)
assert(fn, "S348 unpack failed")
return fn()
